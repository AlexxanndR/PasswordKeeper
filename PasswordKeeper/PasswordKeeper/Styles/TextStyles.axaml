<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles">

	<!-- Compact, readable text fields: keep the caret and selected text readable regardless of theme defaults -->
	<Style Selector="TextBox">
		<Setter Property="Padding" Value="0 0"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="CaretBrush" Value="{DynamicResource SystemBaseHighColor}"/>
		<Setter Property="SelectionForegroundBrush" Value="{DynamicResource SystemBaseHighColor}"/>
		<Setter Property="SelectionBrush">
			<SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.5"/>
		</Setter>
	</Style>

	<Style Selector="TextBox:focus-within /template/ TextBlock#PART_LabelText">
		<Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
	</Style>

	<Style Selector="TextBox /template/ controls|MaterialUnderline#PART_Underline">
		<Setter Property="ActiveBrush" Value="{DynamicResource SystemAccentColor}"/>
	</Style>

	<!-- Same palette trap as TextBox: default selection highlight is invisible under ColorPaletteResources -->
	<Style Selector="SelectableTextBlock">
		<Setter Property="SelectionForegroundBrush" Value="{DynamicResource SystemBaseHighColor}"/>
		<Setter Property="SelectionBrush">
			<SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.5"/>
		</Setter>
	</Style>
</Styles>
