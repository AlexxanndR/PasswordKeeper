<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:controls="using:Material.Styles.Controls"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PasswordKeeper.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="PasswordKeeper.Views.PasswordsListView"
			 x:DataType="vm:PasswordsListViewModel">
	<Design.DataContext>
		<vm:PasswordsListViewModel />
	</Design.DataContext>

	<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
		  Background="{DynamicResource SystemRegionColor}">
		<controls:FloatingButton Grid.RowSpan="2"
								 Margin="15 10"
								 HorizontalAlignment="Right" VerticalAlignment="Bottom"
								 Classes="Mini"
								 Background="{DynamicResource SystemAccentColor}"
								 Command="{Binding AddPasswordCommand}">
			<materialIcons:MaterialIcon Width="25" Height="25"
										Foreground="Black"
										Kind="Plus"/>
		</controls:FloatingButton>
	</Grid>

</UserControl>
