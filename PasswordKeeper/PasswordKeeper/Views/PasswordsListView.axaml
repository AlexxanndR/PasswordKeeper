<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:controls="using:Material.Styles.Controls"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PasswordKeeper.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="PasswordKeeper.Views.PasswordsListView"
			 x:DataType="vm:PasswordsListViewModel">
	<Design.DataContext>
		<vm:PasswordsListViewModel />
	</Design.DataContext>

	<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
		  Margin="5"
		  Background="{DynamicResource SystemRegionColor}">
		<ItemsControl x:Name="PasswordsListControl" ItemsSource="{Binding Passwords}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Vertical"
								HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
								Spacing="5" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:PasswordViewModel">
						<controls:Card HorizontalAlignment="Stretch" VerticalAlignment="Top"
									   Height="70"
									   Margin="5 10" Padding="10 4"
									   Background="{DynamicResource SystemListLowColor}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="8*"/>
								<ColumnDefinition Width="72*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<Image Grid.Column="0"
								   Source="{Binding Password.Platform.Icon, Converter={StaticResource StringToImageConverter}}"
								   HorizontalAlignment="Center" VerticalAlignment="Center"
								   Stretch="Uniform"/>
							<StackPanel Grid.Column="1"
										VerticalAlignment="Center"
										Spacing="2">
								<TextBlock Classes="Headline3"
										   FontSize="20"
										   FontFamily="{StaticResource PlayFont}"
										   Text="{Binding Password.Platform.Name}" />
								<SelectableTextBlock FontFamily="{StaticResource PlayFont}"
													 FontSize="18"
													 Foreground="{DynamicResource SystemBaseMediumColor}"
													 Text="{Binding DisplayPassword}" />
							</StackPanel>
							<StackPanel Grid.Column="2"
										Orientation="Horizontal"
										Spacing="10">
								<Button Command="{Binding TogglePasswordVisibilityCommand}"
										MinHeight="0" Padding="12 4">
									<Panel>
										<materialIcons:MaterialIcon Width="25" Height="25"
																	Foreground="{DynamicResource SystemBaseHighColor}"
																	Kind="Eye"
																	IsVisible="{Binding !IsPasswordVisible}"/>
										<materialIcons:MaterialIcon Width="25" Height="25"
																	Foreground="{DynamicResource SystemBaseHighColor}"
																	Kind="EyeOff"
																	IsVisible="{Binding IsPasswordVisible}"/>
									</Panel>
								</Button>
								<Button Command="{Binding OpenManagerCommand}"
										MinHeight="0" Padding="12 4">
									<materialIcons:MaterialIcon Width="25" Height="25"
																Foreground="{DynamicResource SystemBaseHighColor}"
																Kind="Edit"/>
								</Button>
								<Button MinHeight="0" Padding="12 4">
									<materialIcons:MaterialIcon Width="25" Height="25"
																Foreground="{DynamicResource SystemBaseHighColor}"
																Kind="Delete"/>
								</Button>
							</StackPanel>
						</Grid>
					</controls:Card>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<controls:FloatingButton Grid.RowSpan="2"
								 Margin="15 15"
								 HorizontalAlignment="Right" VerticalAlignment="Bottom"
								 Classes="Mini"
								 Background="{DynamicResource SystemAccentColor}"
								 Command="{Binding AddPasswordCommand}">
			<materialIcons:MaterialIcon Width="25" Height="25"
										Foreground="Black"
										Kind="Plus"/>
		</controls:FloatingButton>
	</Grid>

</UserControl>
