<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:controls="using:Material.Styles.Controls"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:PasswordKeeper.Views"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PasswordKeeper.ViewModels"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="PasswordKeeper.Views.PasswordManagerView"
			 x:DataType="vm:PasswordManagerViewModel">
	<Design.DataContext>
		<vm:PasswordManagerViewModel />
	</Design.DataContext>

	<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
		  Background="{DynamicResource SystemRegionColor}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Button Grid.Row="0" Theme="{StaticResource MaterialFlatButton}"
				Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top"
				Classes="Mini"
				Background="Transparent"
				ToolTip.Tip="Close"
				Command="{Binding CloseCommand}">
			<materialIcons:MaterialIcon Width="25" Height="25"
										Kind="Close"/>
		</Button>

		<StackPanel Grid.Row="1"
					MaxWidth="500"
					HorizontalAlignment="Stretch" VerticalAlignment="Center"
					Spacing="10">

			<Panel HorizontalAlignment="Center">
				<ToggleButton x:Name="IconPickerToggle"
							  Padding="8"
							  IsChecked="{Binding IsIconPickerOpen}">
					<Image Source="{Binding SelectedIcon, Converter={StaticResource StringToImageConverter}}"
						   Width="48" Height="48"/>
				</ToggleButton>

				<Popup IsOpen="{Binding IsIconPickerOpen, Mode=TwoWay}"
					   IsLightDismissEnabled="True"
					   PlacementTarget="{Binding #IconPickerToggle}"
					   Placement="Bottom">
				<Border Background="{DynamicResource SystemChromeMediumLowColor}"
						CornerRadius="8" Padding="6">
					<StackPanel Spacing="4">
						<ItemsControl ItemsSource="{Binding AvailableIcons}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel MaxWidth="250"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="x:String">
									<Button Theme="{StaticResource MaterialFlatButton}"
											Classes="Mini" Margin="2"
											Background="Transparent"
											Command="{Binding $parent[ItemsControl].((vm:PasswordManagerViewModel)DataContext).SelectIconCommand}"
											CommandParameter="{Binding}">
										<Image Source="{Binding Converter={StaticResource StringToImageConverter}}"
											   Width="36" Height="36"/>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Button Theme="{StaticResource MaterialFlatButton}"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								Command="{Binding ImportIconCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<materialIcons:MaterialIcon Width="20" Height="20"
															VerticalAlignment="Center"
															Kind="ImagePlus"/>
								<TextBlock VerticalAlignment="Center"
										   Text="Import"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Border>
				</Popup>
			</Panel>

			<!-- Icon import validation error -->
			<TextBlock Foreground="#D32F2F" FontSize="12"
					   HorizontalAlignment="Center"
					   TextWrapping="Wrap"
					   Text="{Binding ImportError}"
					   IsVisible="{Binding ImportError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<!-- Icon import success message -->
			<TextBlock Foreground="#43A047" FontSize="12"
					   HorizontalAlignment="Center"
					   TextWrapping="Wrap"
					   Text="{Binding ImportSuccess}"
					   IsVisible="{Binding ImportSuccess, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<!-- Platform name field -->
			<StackPanel Spacing="2">
				<TextBlock Text="Platform"
						   FontSize="12"
						   FontFamily="{StaticResource PlayFont}"
						   Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
				<TextBox FontFamily="{StaticResource PlayFont}"
						 Text="{Binding Name}"/>
			</StackPanel>

			<!-- Password field with reveal toggle -->
			<StackPanel Spacing="2">
				<TextBlock Text="Password"
						   FontSize="12"
						   FontFamily="{StaticResource PlayFont}"
						   Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
				<Grid>
					<TextBox FontFamily="{StaticResource PlayFont}"
							 Padding="8 2 40 2"
							 PasswordChar="•"
							 RevealPassword="{Binding IsPasswordRevealed}"
							 Text="{Binding PasswordValue}"/>
					<Button Theme="{StaticResource MaterialFlatButton}"
							Classes="Mini" Margin="0 0 4 0"
							HorizontalAlignment="Right" VerticalAlignment="Center"
							Background="Transparent"
							Command="{Binding TogglePasswordRevealCommand}">
						<materialIcons:MaterialIcon Width="22" Height="22"
													Kind="{Binding IsPasswordRevealed, Converter={StaticResource PasswordRevealToIconConverter}}"/>
					</Button>
				</Grid>
			</StackPanel>
		</StackPanel>

		<controls:FloatingButton Grid.Row="1"
								 Margin="15"
								 HorizontalAlignment="Right" VerticalAlignment="Bottom"
								 Classes="Mini"
								 Background="{DynamicResource SystemAccentColor}"
								 ToolTip.Tip="Save"
								 Command="{Binding SaveCommand}">
			<materialIcons:MaterialIcon Width="25" Height="25"
										Foreground="Black"
										Kind="ContentSave"/>
		</controls:FloatingButton>
	</Grid>
</UserControl>
